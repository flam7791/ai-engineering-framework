# Build:  docker build -t {{ project_slug }} .
# Run:    see compose.yaml (profiles: standin, local)
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    {{ package_name | upper }}_CORPUS_DIR=/app/corpus

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir .
COPY corpus ./corpus

# Unprivileged user; compose also runs the container read-only.
RUN useradd --create-home --uid 10001 appuser
USER appuser

EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=3s --retries=6 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')"
CMD ["{{ project_slug }}", "serve", "--host", "0.0.0.0", "--port", "8000"]
