class ScriptedModel:
    """Returns fixed replies in order and records the prompts it was sent."""

    name = "scripted"

    def __init__(self, *replies: str):
        self.replies, self.prompts = list(replies), []

    def complete(self, system, user, max_tokens=400):
        self.prompts.append(user)
        return Reply(self.replies.pop(0), self.name, 100, 20, 5)


