import httpx
import pytest
from fastapi.testclient import TestClient

from {{ package_name }}.api import create_app
from {{ package_name }}.llm import (
    ModelError,
    OpenAICompatibleModel,
    RecordingModel,
    ReplayMiss,
    StandInModel,
)


def fake_endpoint(content="Answer. [S1]", status=200):
    def handler(request: httpx.Request) -> httpx.Response:
        body = request.read().decode()
        assert '"temperature": 0' in body or '"temperature":0' in body
        return httpx.Response(
            status,
            json={
                "choices": [{"message": {"content": content}}],
                "usage": {"prompt_tokens": 50, "completion_tokens": 5},
            },
        )

    return httpx.Client(transport=httpx.MockTransport(handler))


def test_openai_compatible_model_parses_reply_and_usage():
    model = OpenAICompatibleModel("http://localhost:11434/v1", "m", client=fake_endpoint())
    reply = model.complete("sys", "user")
    assert reply.text == "Answer. [S1]" and reply.input_tokens == 50


def test_endpoint_error_becomes_model_error():
    model = OpenAICompatibleModel("http://x/v1", "m", client=fake_endpoint(status=500))
    with pytest.raises(ModelError):
        model.complete("sys", "user")


def test_record_then_replay_offline(tmp_path):
    live = OpenAICompatibleModel("http://x/v1", "m", client=fake_endpoint("Recorded. [S1]"))
    RecordingModel(live, tmp_path).complete("sys", "user")
    replayed = RecordingModel(None, tmp_path, offline=True).complete("sys", "user")
    assert replayed.text == "Recorded. [S1]" and replayed.replayed
    with pytest.raises(ReplayMiss):
        RecordingModel(None, tmp_path, offline=True).complete("sys", "a different prompt")


def test_standin_says_not_found_without_overlap():
    assert StandInModel().complete("s", "Question: zebra?\n\nSources:\n").text == "NOT_FOUND"


def test_api_health_and_answer(service):
    client = TestClient(create_app(service))
    health = client.get("/health").json()
    assert health["documents_withheld_above_ceiling"] == 1
    r = client.post("/answer", json={"question": "Do I need original receipts above 25 euros?"})
    assert r.status_code == 200 and r.json()["status"] == "answered"
    assert client.post("/answer", json={"question": ""}).status_code == 422
