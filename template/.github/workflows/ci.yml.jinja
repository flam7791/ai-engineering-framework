name: CI

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        python-version: ["3.10", "3.12"]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
{%- raw %}
          python-version: ${{ matrix.python-version }}
{%- endraw %}
          cache: pip
      - name: Install
        run: pip install -e ".[dev]"
      - name: Lint
        run: |
          ruff check .
          ruff format --check .
      - name: Tests (offline, no model)
        run: pytest
      - name: Evaluation with the stand-in model (plumbing and guardrails)
        run: {{ project_slug }} eval --model standin
      - name: Replay recorded live evaluations (quality), if any
        run: |
          for dir in evals/recordings/*/; do
            [ -d "$dir" ] || continue
            echo "replaying $dir"
            {{ project_slug }} eval --model replay --recordings "$dir" --min-pass 0
          done
      - name: Dependency vulnerability scan
        run: pip-audit .
      - name: Engineering standards
        run: |
          pip install "git+https://github.com/flam7791/ai-engineering-framework"
          aief check .

  container:
    runs-on: ubuntu-latest
    needs: test
    steps:
      - uses: actions/checkout@v4
      - name: Start the stack with the stand-in model
        run: docker compose --profile standin up -d --build --wait
      - name: Ask a question through the API
        run: |
          curl -fsS http://127.0.0.1:8000/health
          curl -fsS -X POST http://127.0.0.1:8000/answer -H 'Content-Type: application/json' \
            -d '{"question": "How many days do I have to submit an expense claim after a trip?"}' \
            | tee answer.json
          grep -q '"status":"answered"' answer.json
      - name: Logs
        if: always()
        run: docker compose --profile standin logs --no-color
